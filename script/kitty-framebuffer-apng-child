#!/usr/bin/env zsh
set -euo pipefail

readonly APNG=''

printf '%s\n' 'Kiwi framebuffer APNG fixture'
print -rn -- $'\e_Ga=t,i=1,s=2,v=2,f=100,t=d,m=0;'"$APNG"$'\e\\'
print -rn -- $'\e_Ga=p,i=1,p=1,c=18,r=8,C=1,z=1\e\\'
printf '%s\n' 'APNG alternates opaque red and blue frames over this text'
sleep 2
