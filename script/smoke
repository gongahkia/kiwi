#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}

cd "$ROOT"
if [[ "$(uname -s)" == Darwin ]]; then
  KIWI_MAX_FRAMES=120 make run ARGS='-- /usr/bin/printf "\033[32mkiwi-live-smoke\033[0m\n"'
  print "GPU/window smoke test passed."
  exit 0
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "SKIP GPU/window smoke test: neither DISPLAY nor WAYLAND_DISPLAY is available."
  exit 0
fi

KIWI_MAX_FRAMES=120 make run ARGS='-- /usr/bin/printf "\033[32mkiwi-live-smoke\033[0m\n"'
print "GPU/window smoke test passed."
