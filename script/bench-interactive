#!/usr/bin/env python3
"""Fresh-process startup and acknowledged callback-to-presentation timing."""
import argparse
import json
import math
import os
from pathlib import Path
import statistics
import subprocess
import sys
import tempfile
import time


def summary(values):
    ordered = sorted(values)
    def percentile(fraction):
        position = fraction * (len(ordered) - 1)
        lo, hi = math.floor(position), math.ceil(position)
        return ordered[lo] + (ordered[hi] - ordered[lo]) * (position - lo)
    return dict(count=len(values), minimum=min(values), maximum=max(values),
                mean=statistics.mean(values), p50=percentile(.5), p95=percentile(.95), p99=percentile(.99))


def write_report(path, result):
    encoded = json.dumps(result, indent=2, allow_nan=False) + "\n"
    assert len(encoded) <= 4 * 1024 * 1024
    temporary = path.with_suffix(path.suffix + ".new")
    temporary.write_text(encoded)
    temporary.replace(path)


def reject_nonfinite(value):
    raise ValueError("trial report contains non-finite JSON value: " + value)


def finite_float(value):
    parsed = float(value)
    if not math.isfinite(parsed):
        reject_nonfinite(value)
    return parsed


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
parser.add_argument("--report", type=Path, required=True)
parser.add_argument("--trials", type=int, default=3)
parser.add_argument("--samples", type=int, default=20)
parser.add_argument("--warmup", type=int, default=5)
parser.add_argument("--interval-ms", type=float, default=20)
parser.add_argument("--mode", choices=("idle", "saturated", "both"), default="both")
parser.add_argument("--read-budget", type=int, default=16384, help="maximum ordinary PTY bytes per application turn")
parser.add_argument("--traffic", choices=("ascii", "styled-unicode"), default="ascii")
parser.add_argument("--scroll-mode", choices=("region", "history"), default="region")
parser.add_argument("--scrollback-limit", type=int, default=2000, help="retained history rows, 0–100000")
parser.add_argument("--soak-seconds", type=float, default=0,
                    help="60–1800 seconds between first/last measured inputs; overrides --interval-ms")
parser.add_argument("--max-rss-growth-mib", type=float, default=64)
parser.add_argument("--max-heap-growth-mib", type=float, default=16)
parser.add_argument("--heap-measurement", choices=("sampled", "retained"), default="sampled",
                    help="sampled quarter medians (default), or full-GC endpoints outside timed inputs")
parser.add_argument("--max-rss-mib", type=float, default=1024)
parser.add_argument("--keep-visible", action="store_true", help="float the owned benchmark window above normal windows (macOS GLFW only)")
args = parser.parse_args()
if args.heap_measurement == "retained" and not args.soak_seconds:
    parser.error("retained heap measurement requires a sustained duration")
if args.keep_visible and (sys.platform != "darwin" or os.environ.get("KIWI_HOST") == "gtk"):
    parser.error("--keep-visible requires the macOS GLFW host")
if not (1 <= args.trials <= 10 and 1 <= args.samples <= 256 and 0 <= args.warmup <= 32
        and 0 <= args.interval_ms <= 1000 and 1 <= args.read_budget <= 1024 * 1024):
    parser.error("counts/interval exceed supported bounds")
if not (args.soak_seconds == 0 or 60 <= args.soak_seconds <= 1800):
    parser.error("soak duration must be zero or 60–1800 seconds")
if any(not math.isfinite(value) or not 0 <= value <= 4096 for value in
       (args.max_rss_growth_mib, args.max_heap_growth_mib, args.max_rss_mib)):
    parser.error("memory budgets must be finite values between 0 and 4096 MiB")
if args.soak_seconds and args.samples < 20:
    parser.error("sustained qualification requires at least 20 measured inputs")
if not args.soak_seconds and (args.samples + args.warmup - 1) * args.interval_ms > 20000:
    parser.error("requested intervals consume more than 20 seconds of the 30-second trial budget")
if not 0 <= args.scrollback_limit <= 100000:
    parser.error("scrollback limit must be between 0 and 100000 rows")
if args.scroll_mode == "history" and (args.mode != "saturated" or not args.soak_seconds or not args.scrollback_limit):
    parser.error("history qualification requires saturated mode, a sustained duration and a positive scrollback limit")
if args.mode != "idle" and args.warmup < 1:
    parser.error("saturated trials require a warmup input to start background output after startup")
interval = args.soak_seconds / (args.samples - 1) if args.soak_seconds else args.interval_ms / 1000
trial_timeout = math.ceil(30 + (args.samples + args.warmup - 1) * (interval + 2)) if args.soak_seconds else 30
assert trial_timeout <= 3600
root, report_path = args.root.resolve(), args.report.resolve()
report_path.parent.mkdir(parents=True, exist_ok=True)
logs = report_path.parent / (report_path.stem + "-logs")
logs.mkdir(exist_ok=True)
modes = ("idle", "saturated") if args.mode == "both" else (args.mode,)
result = {"schema_version": 1, "status": "running", "benchmark": "acknowledged interactive application timing", "trials": [],
          "methodology": {
              "clock": "CLOCK_MONOTONIC in parent and native process metrics; launch timestamp immediately before subprocess creation",
              "startup": "fresh process with normal filesystem/driver caches; includes interpreter, host/font/GPU setup and controlled Python child; not a cold-cache or login-shell benchmark",
              "first_present": "return from the first successful WGPU compositor presentation, possibly before child output",
              "ready_present": "successful presentation return after parsing child readiness and verifying matching visible model text",
              "input": "synthetic text callback through real input encoding, PTY delivery, numbered child acknowledgment, parsing and successful WGPU presentation return",
              "association": "one outstanding sequence; unrelated output or frames cannot complete an input sample",
              "phase_diagnostics": "while input is pending, bounded read/parse/prepare/render/wait/flush wall and process-CPU counters are retained for failed and slowest measured acknowledgments; process CPU includes native worker threads and can exceed wall time; instrumentation adds clock reads",
              "load": "bounded nonblocking child output started by first warmup input; region mode scrolls below the acknowledgment row; history mode scrolls the full primary screen and repaints a top-right acknowledgment between lines",
              "sampling": "warmup inputs excluded; startup has one observation per fresh process; pooled input summaries are diagnostic and not independent process-level samples",
              "exclusions": "physical input delivery, IME, GPU completion, compositor display feedback and panel scan-out are not measured",
              "memory": "sampled process RSS after successful presentations; not OS high-water RSS",
              "bounds": "explicit internal deadline plus ten seconds for external cleanup; two-second acknowledgment ceiling; at most 256 measured inputs, 32 warmup inputs and 256 resource observations per trial"},
          "trial_timeout_seconds": trial_timeout,
          "soak_policy": {"minimum_seconds": args.soak_seconds, "max_rss_growth_mib": args.max_rss_growth_mib,
                          "max_heap_growth_mib": args.max_heap_growth_mib, "max_rss_mib": args.max_rss_mib,
                          "heap_measurement": args.heap_measurement,
                          "growth": ("RSS: last-quarter minus first-quarter median; Lua heap: post-collection final minus initial while app is live"
                                     if args.heap_measurement == "retained" else
                                     "last-quarter minus first-quarter median of post-warmup presentation samples; no forced GC"),
                          "collection": ("one full collection after warmup and one after the final timed input, before teardown; normal GC during interval"
                                         if args.heap_measurement == "retained" else "no forced collection"),
                          "history": "resource samples include actual retained rows, pushes and evictions to distinguish capacity filling from steady-state growth; budgets remain unchanged",
                          "sampling": "bounded periodic observations on successful presents; no additional wake timer; CPU percent can exceed 100 on multiple cores"}}
write_report(report_path, result)
with tempfile.TemporaryDirectory(prefix="kiwi-interactive-bench-") as temporary:
    temporary = Path(temporary)
    config = temporary / "config"
    config.write_text(f"theme = kiwi\nfont-size = 18\nscrollback-limit = {args.scrollback_limit}\nlive-config-reload = false\n")
    # Prevent unrelated diagnostic knobs from contaminating a comparison.
    keep = {"KIWI_HOST", "KIWI_GTK_PRESENTER", "KIWI_SURFACE_LIB", "KIWI_WGPU_LIB"}
    base = {key: value for key, value in os.environ.items() if not key.startswith("KIWI_") or key in keep}
    base.update(KIWI_ROOT=str(root), LUA_PATH="src/?.lua;src/?/init.lua;;", KIWI_LAYOUT_PERSISTENCE="0",
                KIWI_LAYOUT_RESTORE="0", KIWI_MAX_SECONDS="0", KIWI_MAX_FRAMES="0", KIWI_PTY_READ_BUDGET=str(args.read_budget),
                KIWI_INTERACTIVE_BENCH_TRAFFIC=args.traffic, KIWI_INTERACTIVE_BENCH_SCROLL_MODE=args.scroll_mode,
                KIWI_INTERACTIVE_BENCH_SCROLLBACK_LIMIT=str(args.scrollback_limit),
                KIWI_INTERACTIVE_BENCH_HEAP_MEASUREMENT=args.heap_measurement,
                KIWI_INTERACTIVE_BENCH_CONFIG=str(config), KIWI_INTERACTIVE_BENCH_PYTHON=sys.executable,
                KIWI_INTERACTIVE_BENCH_SAMPLES=str(args.samples), KIWI_INTERACTIVE_BENCH_WARMUP=str(args.warmup),
                KIWI_INTERACTIVE_BENCH_INTERVAL=str(interval), KIWI_INTERACTIVE_BENCH_TIMEOUT=str(trial_timeout),
                KIWI_INTERACTIVE_BENCH_SOAK=str(args.soak_seconds), KIWI_INTERACTIVE_BENCH_KEEP_VISIBLE="1" if args.keep_visible else "0")
    for mode in modes:
        for trial in range(1, args.trials + 1):
            output = temporary / "trial.json"
            output.unlink(missing_ok=True)
            environment = dict(base, KIWI_INTERACTIVE_BENCH_MODE=mode, KIWI_INTERACTIVE_BENCH_TRIAL_REPORT=str(output))
            log = logs / f"{mode}-{trial}.log"
            item = None
            with log.open("w") as stream:
                environment["KIWI_INTERACTIVE_BENCH_LAUNCHED_AT"] = str(time.clock_gettime(time.CLOCK_MONOTONIC))
                try:
                    process = subprocess.run([base.get("LUAJIT", "luajit"), "src/kiwi/interactive_bench.lua"], cwd=root,
                                             env=environment, stdout=stream, stderr=subprocess.STDOUT, timeout=trial_timeout + 10)
                    if not output.exists():
                        process.check_returncode()
                        raise RuntimeError("trial produced no report")
                    assert output.stat().st_size <= 128 * 1024, "trial report exceeds size limit"
                    item = json.loads(output.read_text(), parse_constant=reject_nonfinite, parse_float=finite_float)
                    item["trial"], item["mode"] = trial, mode
                    result["trials"].append(item)
                    process.check_returncode()
                    assert item.get("status", "complete") == "complete", "trial reported incomplete measurements"
                    assert item["measurement"]["samples"] == args.samples
                    if args.scroll_mode == "history":
                        history = item["measurement"]["history"]
                        assert history["limit"] == args.scrollback_limit, "history capacity differs from configuration"
                        assert history["retained"] == history["peak_retained"] == args.scrollback_limit, "history did not reach its configured capacity"
                        assert history["evicted"] >= args.scrollback_limit, "history did not replace one complete capacity of rows"
                        assert history["pushed"] == history["retained"] + history["evicted"], "history retention accounting differs from actual pushes"
                    if args.soak_seconds:
                        sustained = item["measurement"]["sustained"]
                        assert sustained["duration_seconds"] >= args.soak_seconds, "sustained duration was shorter than requested"
                        assert len(sustained["samples"]) >= 5, "insufficient resource observations"
                        for name, maximum in (("rss_kib", args.max_rss_growth_mib), ("heap_kib", args.max_heap_growth_mib)):
                            growth = sustained[name]["growth"]
                            if name == "heap_kib" and args.heap_measurement == "retained":
                                retained = item["measurement"]["retained_heap"]
                                assert retained["duration_seconds"] >= args.soak_seconds, "retained interval was shorter than requested"
                                initial, final = retained["initial"], retained["final"]
                                for checkpoint in (initial, final):
                                    assert all(math.isfinite(checkpoint[key]) and checkpoint[key] >= 0
                                               for key in ("before_kib", "after_kib", "collection_seconds", "started_at", "finished_at")), "invalid retained heap checkpoint"
                                    assert checkpoint["finished_at"] >= checkpoint["started_at"], "retention clock moved backwards"
                                    if args.scroll_mode == "history":
                                        assert checkpoint["history"]["retained"] == checkpoint["history"]["limit"] == args.scrollback_limit, "retention checkpoint did not have full history"
                                assert final["started_at"] - initial["finished_at"] >= args.soak_seconds, "retention checkpoint interval was shorter than requested"
                                growth = final["after_kib"] - initial["after_kib"]
                                assert math.isclose(growth, retained["growth_kib"], rel_tol=1e-7, abs_tol=0.01), "retained growth differs from checkpoints"
                            assert math.isfinite(growth) and growth <= maximum * 1024, f"{name} growth {growth / 1024:.1f} MiB exceeds {maximum} MiB"
                        assert item["measurement"]["sampled_peak_rss_kib"] <= args.max_rss_mib * 1024, "sampled peak RSS exceeded its budget"
                except Exception as error:
                    result["status"] = "invalid" if item and item.get("status") == "invalid" else "failed"
                    result["failure"] = dict(mode=mode, trial=trial, log=str(log), reason=str(error)[:1024])
                    write_report(report_path, result)
                    print(f"Interactive trial failed; log: {log}", file=sys.stderr)
                    raise
            write_report(report_path, result)
            timing = item["measurement"]
            print(f"{mode} trial={trial} startup-ready={timing['launch_to_child_ready_present_return_ms']:.1f}ms "
                  f"ack-p95={timing['callback_to_present_return_ms']['p95']:.2f}ms "
                  f"rss={timing['sampled_peak_rss_kib']/1024:.1f}MiB", flush=True)
result["summary"] = {}
for mode in modes:
    observations = [trial["measurement"] for trial in result["trials"] if trial["mode"] == mode]
    aggregate = {}
    for name in ("launch_to_first_present_return_ms", "launch_to_child_ready_present_return_ms", "sampled_peak_rss_kib"):
        aggregate[name] = summary([observation[name] for observation in observations])
    for name in ("callback_to_parse_ms", "parse_to_present_return_ms", "callback_to_present_return_ms"):
        aggregate[name] = summary([value for observation in observations for value in observation[name]["values"]])
    result["summary"][mode] = aggregate
result["status"] = "complete"
write_report(report_path, result)
print(f"Report: {report_path}; excludes physical keyboard/display latency.")
