#!/usr/bin/env sh
set -eu

mode=${KIWI_PROFILE_MODE:-ascii}
iterations=${KIWI_PROFILE_ITERATIONS:-100000}
output=${KIWI_PROFILE_OUTPUT:-bench/profiles/$(date -u +%Y%m%dT%H%M%SZ)-${mode}.txt}
kiwi_luajit=${LUAJIT:-luajit}
trace=${KIWI_PROFILE_TRACE:-0}

case "$mode" in
  ascii|ascii_full|combining|cjk|mixed|replay|live_ascii) ;;
  *)
    echo "KIWI_PROFILE_MODE must be ascii, ascii_full, combining, cjk, mixed, replay, or live_ascii" >&2
    exit 2
    ;;
esac

if [ "$trace" = 1 ]; then
  set -- -jp=vl -jv
else
  set -- -jp=vl
fi

LUAJIT_PROFILEFILE="$output" "$kiwi_luajit" "$@" src/kiwi/bench/profile_text.lua 2> "${output%.txt}.trace"

echo "LuaJIT profile: $output"
if [ "$trace" = 1 ]; then echo "LuaJIT trace: ${output%.txt}.trace"; fi
