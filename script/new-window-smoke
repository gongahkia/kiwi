#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}
if [[ "$(uname -s)" != Darwin && -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "SKIP native new-window smoke: neither DISPLAY nor WAYLAND_DISPLAY is available."
  exit 0
fi

make -C "$ROOT" native terminfo
KIWI_MAX_FRAMES="${KIWI_MAX_FRAMES:-2}" \
  KIWI_MAX_SECONDS="${KIWI_MAX_SECONDS:-3}" \
  "${LUAJIT:-luajit}" "$ROOT/src/kiwi/app/main.lua" --no-extensions --multi-window-smoke -- /usr/bin/yes
