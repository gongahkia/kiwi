#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
binary=$(mktemp "${TMPDIR:-/tmp}/kiwi-pty-watch.XXXXXX")
trap 'rm -f "$binary"' EXIT HUP INT TERM
${CC:-cc} -std=c17 -pthread -Wall -Wextra -Werror ${CFLAGS:-} -Inative \
  native/pty_watch.c src/tests/fixtures/pty_watch_test.c -o "$binary"
"$binary"
