#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}
readonly WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

KIWI_RELEASE_ALLOW_DIRTY=1 KIWI_RELEASE_DIST="$WORK/first" "$ROOT/script/release-build"
KIWI_RELEASE_ALLOW_DIRTY=1 KIWI_RELEASE_DIST="$WORK/second" "$ROOT/script/release-build"

readonly VERSION=$(<"$ROOT/VERSION")
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) readonly TARGET=linux-x86_64; readonly LIBRARY_EXTENSION=so ;;
  Darwin-arm64) readonly TARGET=macos-arm64; readonly LIBRARY_EXTENSION=dylib ;;
  Darwin-x86_64) readonly TARGET=macos-x86_64; readonly LIBRARY_EXTENSION=dylib ;;
  *) print -u2 "release checks require a supported Kiwi target"; exit 1 ;;
esac
readonly NAME="kiwi-$VERSION-$TARGET"
cmp "$WORK/first/$NAME.tar.gz" "$WORK/second/$NAME.tar.gz"
if command -v sha256sum >/dev/null; then
  (cd "$WORK/first" && sha256sum --check "$NAME.tar.gz.sha256")
else
  (cd "$WORK/first" && shasum -a 256 -c "$NAME.tar.gz.sha256")
fi
tar -xzf "$WORK/first/$NAME.tar.gz" -C "$WORK"
version_output=$(KIWI_DEVELOPMENT=1 "$WORK/$NAME/bin/kiwi" --version)
[[ "$version_output" == "Kiwi $VERSION (revision "*", mode release)" ]]
[[ -f "$WORK/$NAME/metadata.json" ]]
[[ -d "$WORK/$NAME/share/terminfo" ]]
[[ -f "$WORK/$NAME/lib/libkiwi_surface.$LIBRARY_EXTENSION" ]]
if [[ "$TARGET" == linux-x86_64 ]]; then
  [[ -f "$WORK/$NAME/share/applications/kiwi.desktop" ]]
else
  [[ -x "$WORK/$NAME/Kiwi.app/Contents/MacOS/Kiwi" ]]
  plutil -lint "$WORK/$NAME/Kiwi.app/Contents/Info.plist" >/dev/null
  [[ "$(plutil -extract NSAppleScriptEnabled raw "$WORK/$NAME/Kiwi.app/Contents/Info.plist")" == "true" ]]
  [[ "$(plutil -extract OSAScriptingDefinition raw "$WORK/$NAME/Kiwi.app/Contents/Info.plist")" == "Kiwi.sdef" ]]
  [[ -f "$WORK/$NAME/Kiwi.app/Contents/Resources/Kiwi.sdef" ]]
  sdp -fh -o "$WORK/Kiwi.h" "$WORK/$NAME/Kiwi.app/Contents/Resources/Kiwi.sdef"
  rg -q 'newTerminalWindow' "$WORK/Kiwi.h"
  otool -l "$WORK/$NAME/Kiwi.app/Contents/MacOS/Kiwi" | rg -q 'LC_UUID'
  app_executable="$WORK/$NAME/Kiwi.app/Contents/MacOS/Kiwi"
  KIWI_MAX_FRAMES=0 /usr/bin/open -n "$WORK/$NAME/Kiwi.app"
  app_pid=''
  for _ in {1..50}; do
    app_pid=$(pgrep -f "$app_executable" || true)
    [[ "$app_pid" == <-> ]] && break
    sleep 0.1
  done
  [[ "$app_pid" == <-> ]]
  kill -0 "$app_pid"
  kill "$app_pid"
  for _ in {1..50}; do
    pgrep -f "$app_executable" >/dev/null || break
    sleep 0.1
  done
  ! pgrep -f "$app_executable" >/dev/null
fi
[[ -f "$WORK/$NAME/share/doc/kiwi/README.md" ]]
[[ -x "$WORK/$NAME/bin/kiwi-image" ]]
[[ -x "$WORK/$NAME/bin/kiwi-ssh" ]]
[[ -x "$WORK/$NAME/bin/kiwi-vt" ]]
for document in ACCESSIBILITY AUR CONFORMANCE MACOS NIX RENDERER_API SHELL_INTEGRATION SUPPORT TEXT USER_GUIDE; do
  [[ -f "$WORK/$NAME/share/doc/kiwi/docs/$document.md" ]]
done
[[ -f "$WORK/$NAME/share/kiwi/integrations/v1/kiwi.bash" ]]
[[ -f "$WORK/$NAME/share/kiwi/integrations/v1/kiwi.nu" ]]
[[ -f "$WORK/$NAME/share/kiwi/integrations/v1/inject/kiwi.bashrc" ]]
"$WORK/$NAME/bin/kiwi-vt" --help >/dev/null
"$WORK/$NAME/bin/kiwi-ssh" --help >/dev/null

print "Kiwi release check: reproducible archive, checksum, metadata, linked docs, release-mode launcher, and macOS app-bundle launch passed."
