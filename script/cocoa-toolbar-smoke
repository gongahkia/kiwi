#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}
if [[ "$(uname -s)" != Darwin ]]; then
  print "SKIP Cocoa titlebar-toolbar smoke: macOS is required."
  exit 0
fi

export LUA_PATH="$ROOT/src/?.lua;$ROOT/src/?/init.lua;;"
make -C "$ROOT" native terminfo
log=$(mktemp "${TMPDIR:-/tmp}/kiwi-cocoa-toolbar.XXXXXX")
trap 'rm -f "$log"' EXIT
KIWI_LAYOUT_PERSISTENCE=0 \
  KIWI_LAYOUT_RESTORE=0 \
  KIWI_MAX_FRAMES="${KIWI_MAX_FRAMES:-2}" \
  KIWI_MAX_SECONDS="${KIWI_MAX_SECONDS:-3}" \
  "${LUAJIT:-luajit}" "$ROOT/src/kiwi/app/main.lua" --no-extensions --toolbar-smoke -- /usr/bin/yes | tee "$log"
rg -q "Kiwi native titlebar-toolbar smoke passed" "$log"
