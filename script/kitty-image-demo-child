#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}

printf '%s\n' 'Kitty image composition fixture'
KIWI_IMAGE_ID=1 KIWI_IMAGE_PLACEMENT_ID=1 KIWI_IMAGE_COLUMNS=18 KIWI_IMAGE_ROWS=8 KIWI_IMAGE_Z=-1 \
  "$ROOT/script/kiwi-image" --file "$ROOT/assets/kiwi-bird.png"
printf '%s\n' 'negative z stays behind this text and selection'
KIWI_IMAGE_ID=1 KIWI_IMAGE_PLACEMENT_ID=2 KIWI_IMAGE_COLUMNS=18 KIWI_IMAGE_ROWS=1 KIWI_IMAGE_Z=1 \
  "$ROOT/script/kiwi-image" --place-only
printf '%s\n' 'zero or positive z appears over glyphs; cursor remains last'
sleep 1
