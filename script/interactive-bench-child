#!/usr/bin/env python3
"""Raw PTY acknowledgment producer; only the benchmark launches this child."""
import os
import selectors
import signal
import sys
import tty

mode = sys.argv[1]
assert mode in ("idle", "saturated")
scroll_mode = os.environ.get("KIWI_INTERACTIVE_BENCH_SCROLL_MODE", "region")
assert scroll_mode in ("region", "history")
tty.setraw(0)
os.set_blocking(0, False)
os.set_blocking(1, False)
# Initial window allocation can resize the PTY after READY was emitted. Like a
# full-screen application, repaint after SIGWINCH instead of assuming the first
# grid survives. A wakeup pipe keeps the child idle without a polling timer.
resize_read, resize_write = os.pipe()
os.set_blocking(resize_read, False)
os.set_blocking(resize_write, False)
signal.set_wakeup_fd(resize_write)
signal.signal(signal.SIGWINCH, lambda *_: None)
rows = os.get_terminal_size(0).lines
assert rows >= 3
sequence = 0
ready = b"\x1b[?25l\x1b[2J\x1b]2;kiwi-bench-ready\x07\x1b[HREADY0000"
def position():
    return f"\x1b[{rows if scroll_mode == 'history' else 2};1H".encode()


def margins():
    return b"\x1b[r" if scroll_mode == "history" else f"\x1b[2;{rows}r".encode()


def acknowledgment():
    return f"\x1b[1;1HACK{sequence:04d}  ".encode() + position()


pending = ready + margins() + position()
# Region mode reserves row one. History mode scrolls the whole primary screen
# and repaints the acknowledgment after each bounded batch; full-screen scroll
# must reach the real history ring and evict old rows once it fills.
traffic = (b"background output 0123456789 abcdefghijklmnopqrstuvwxyz\r\n" * 64)
if os.environ.get("KIWI_INTERACTIVE_BENCH_TRAFFIC", "ascii") == "styled-unicode":
    traffic = ("\x1b[1;38;2;90;180;230m背景 café e\u0301 Ελληνικά\x1b[0m "
               "\x1b[3m日本語\x1b[0m \x1b[4:3munderlined\x1b[0m\r\n").encode() * 32
selector = selectors.DefaultSelector()
selector.register(0, selectors.EVENT_READ)
selector.register(1, selectors.EVENT_WRITE)
selector.register(resize_read, selectors.EVENT_READ)
writing = True
while True:
    events = selector.select()
    if any(key.fd == resize_read for key, _ in events):
        os.read(resize_read, 4096)
        if sequence == 0:
            rows = os.get_terminal_size(0).lines
            # Append to preserve escape sequences if an earlier write split.
            pending += ready + margins() + position()
    # Read first even when the PTY is continuously writable.
    for key, _ in events:
        if key.fd == 0:
            try:
                data = os.read(0, 256)
            except BlockingIOError:
                continue
            if not data:
                sys.exit(0)
            assert data == b"x", "benchmark requires exactly one outstanding input"
            sequence += 1
            assert sequence <= 288
            if sequence == 1:
                rows = os.get_terminal_size(0).lines
                pending += margins()
            pending += f"\x1b]2;kiwi-bench-ack:{sequence}\x07".encode() + acknowledgment()
    # Let the parent observe startup before background output can scroll or
    # race the initial native allocation. The first warmup input starts load.
    if not pending and mode == "saturated" and sequence > 0:
        pending = traffic + (acknowledgment() if scroll_mode == "history" else b"")
    assert len(pending) <= 8192, "child output queue exceeded its bound"
    if pending and not writing:
        selector.register(1, selectors.EVENT_WRITE)
        writing = True
    if writing and any(key.fd == 1 for key, _ in events):
        try:
            count = os.write(1, pending)
            pending = pending[count:]
        except BlockingIOError:
            pass
        if not pending and (mode == "idle" or sequence == 0):
            selector.unregister(1)
            writing = False
