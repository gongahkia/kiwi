#!/usr/bin/env zsh
set -euo pipefail

# A noninteractive common bash/zsh/fish-shaped stream for native retention
# verification. It changes no shell startup configuration.
print -rn -- $'\e]7;file://kiwi.example/history\a'
for index in {1..12}; do
  print -rn -- $'\e]133;A\a'
  print -rn -- "kiwi$ printf $index"
  print -rn -- $'\e]133;B\a'
  print -r -- "printf $index"
  print -rn -- $'\e]133;C\a'
  print -r -- "$index"
  print -rn -- $'\e]133;D;0\a'
done
