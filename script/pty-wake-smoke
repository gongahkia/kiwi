#!/usr/bin/env python3
"""Exercise finite and indefinite native waits under an external watchdog."""
import os
from pathlib import Path
import subprocess

os.chdir(Path(__file__).resolve().parent.parent)
for wait in ("finite", "indefinite"):
    environment = dict(os.environ, KIWI_WAKE_WAIT=wait)
    environment.setdefault("LUA_PATH", "src/?.lua;src/?/init.lua;;")
    subprocess.run([os.environ.get("LUAJIT", "luajit"), "src/kiwi/pty_wake_smoke.lua"],
                   env=environment, check=True, timeout=20)
