#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}
readonly TERMINFO_DIR="$ROOT/.build/terminfo"
readonly WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/kiwi-conformance.XXXXXX")
readonly TOP_RECORDING="$WORK_DIR/top.jsonl"
readonly VT_RECORDING="$WORK_DIR/vttest-style.jsonl"
readonly VIM_RECORDING="$WORK_DIR/vim-mouse.jsonl"
readonly NVIM_RECORDING="$WORK_DIR/nvim-keyboard.jsonl"
readonly TRUECOLOUR_RECORDING="$WORK_DIR/truecolour-contract.jsonl"
readonly REPLAY_LOG="$WORK_DIR/replay.stderr"
readonly TMUX_SOCKET="kiwi-conformance-$$"

cleanup() {
  tmux -L "$TMUX_SOCKET" kill-server >/dev/null 2>&1 || true
  rm -rf -- "$WORK_DIR"
}
trap cleanup EXIT

cd "$ROOT"

recorded_output() {
  rg -o '"data":"[^"]*' "$1" | sed 's/"data":"//' | while IFS= read -r encoded; do
    print -rn -- "$encoded" | base64 -d
  done
}

TERMINFO="$TERMINFO_DIR" infocmp -1 kiwi >/dev/null
[[ "$(TERM=kiwi TERMINFO="$TERMINFO_DIR" tput colors)" == "16" ]] || {
  print -u2 "Kiwi terminfo must advertise exactly 16 colours."
  exit 1
}

terminfo_output=$(TERMINFO="$TERMINFO_DIR" infocmp -1 kiwi)
if print -r -- "$terminfo_output" | grep -Eq '(^|[[:space:]])(RGB|Tc|setrgbf|setrgbb)([=,#,]|$)'; then
  print -u2 "Kiwi terminfo must not advertise an unvalidated truecolour capability."
  exit 1
fi

print "terminfo: colors=16; RGB/Tc/setrgbf/setrgbb absent"
print "platform: $(uname -srmo)"

if command -v tmux >/dev/null; then
  env -u COLORTERM TERM=kiwi TERMINFO="$TERMINFO_DIR" tmux -L "$TMUX_SOCKET" new-session -d -s kiwi-evidence '/bin/sh -c '"'"'printf "term=%s colorterm=%s colors=" "$TERM" "${COLORTERM-unset}"; tput colors; sleep 2'"'"''
  sleep 1
  tmux_output=$(tmux -L "$TMUX_SOCKET" capture-pane -pt kiwi-evidence -S -20)
  print "tmux: ${tmux_output//$'\n'/; }"
  [[ "$tmux_output" == *"term="* && "$tmux_output" != *"term=kiwi"* && "$tmux_output" == *"colors=256"* ]] || {
    print -u2 "tmux did not expose its own 256-colour inner TERM contract."
    exit 1
  }
else
  print "tmux: No access (not installed)"
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "native-top: No access (neither DISPLAY nor WAYLAND_DISPLAY is available)"
elif ! command -v top >/dev/null; then
  print "native-top: No access (top is not installed)"
else
  top_command=$(command -v top)
  top_version=$($top_command --version 2>&1 | sed -n '1p')
  KIWI_MAX_FRAMES="${KIWI_CONFORMANCE_MAX_FRAMES:-120}" make run ARGS="--record $TOP_RECORDING -- $top_command -n 1 -d 0.1"
  make replay REPLAY="$TOP_RECORDING" >/dev/null 2>"$REPLAY_LOG"
  replay=$(<"$REPLAY_LOG")
  print "native-top: $top_version; ${replay//$'\n'/; }"
  [[ "$replay" == *"errors=0 ignored=0 unknown=csi:0,esc:0,osc:0,string:0"* ]] || {
    print -u2 "native top recording contains parser errors, ignored actions, or unknown terminal controls."
    exit 1
  }
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "native-vt-exercise: No access (neither DISPLAY nor WAYLAND_DISPLAY is available)"
else
  KIWI_MAX_FRAMES="${KIWI_CONFORMANCE_MAX_FRAMES:-120}" make run ARGS="--record $VT_RECORDING -- $ROOT/script/vttest-style-child"
  make replay REPLAY="$VT_RECORDING" >/dev/null 2>"$REPLAY_LOG"
  replay=$(<"$REPLAY_LOG")
  print "native-vt-exercise: ${replay//$'\n'/; }"
  [[ "$replay" == *"errors=0 ignored=0 unknown=csi:0,esc:0,osc:0,string:0"* ]] || {
    print -u2 "native VT exercise contains parser errors, ignored actions, or unknown terminal controls."
    exit 1
  }
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "native-truecolour-contract: No access (neither DISPLAY nor WAYLAND_DISPLAY is available)"
else
  KIWI_MAX_FRAMES="${KIWI_CONFORMANCE_MAX_FRAMES:-120}" make run ARGS="--record $TRUECOLOUR_RECORDING -- $ROOT/script/truecolour-contract-child"
  make replay REPLAY="$TRUECOLOUR_RECORDING" >/dev/null 2>"$REPLAY_LOG"
  replay=$(<"$REPLAY_LOG")
  truecolour_output=$(recorded_output "$TRUECOLOUR_RECORDING")
  print "native-truecolour-contract: ${replay//$'\n'/; }"
  [[ "$replay" == *"errors=0 ignored=0 unknown=csi:0,esc:0,osc:0,string:0"* && "$truecolour_output" == *"TERM=kiwi COLORTERM=unset colors=16"* && "$truecolour_output" == *$'\e[38;2;1;2;3m'* ]] || {
    print -u2 "native truecolour contract did not retain the documented fallback."
    exit 1
  }
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "native-nvim-keyboard: No access (neither DISPLAY nor WAYLAND_DISPLAY is available)"
elif ! command -v nvim >/dev/null; then
  print "native-nvim-keyboard: No access (nvim is not installed)"
else
  nvim_command=$(command -v nvim)
  nvim_version=$($nvim_command --version 2>&1 | sed -n '1p')
  KIWI_MAX_FRAMES="${KIWI_CONFORMANCE_MAX_FRAMES:-120}" make run ARGS="--record $NVIM_RECORDING -- $nvim_command -u NONE -n -c 'sleep 200m' -c 'qa!'"
  make replay REPLAY="$NVIM_RECORDING" >/dev/null 2>"$REPLAY_LOG"
  replay=$(<"$REPLAY_LOG")
  keyboard_bytes=$(rg -o '"data":"[^"]*' "$NVIM_RECORDING" | sed 's/"data":"//' | while IFS= read -r encoded; do print -rn -- "$encoded" | base64 -d; done | tr '\033' '@')
  print "native-nvim-keyboard: $nvim_version; ${replay//$'\n'/; }"
  [[ "$replay" == *"errors=0"* && "$keyboard_bytes" == *'@[?u'* && "$keyboard_bytes" == *'@[>1u'* && "$keyboard_bytes" == *'@[<u'* ]] || {
    print -u2 "native Neovim recording did not complete the Kitty keyboard query/push/pop exchange."
    exit 1
  }
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  print "native-vim-mouse: No access (neither DISPLAY nor WAYLAND_DISPLAY is available)"
elif ! command -v vim >/dev/null; then
  print "native-vim-mouse: No access (vim is not installed)"
else
  vim_command=$(command -v vim)
  vim_version=$($vim_command --version 2>&1 | sed -n '1p')
  KIWI_MAX_FRAMES="${KIWI_CONFORMANCE_MAX_FRAMES:-120}" make run ARGS="--record $VIM_RECORDING -- $vim_command -Nu NONE -n -c 'set ttym=sgr' -c 'set mouse=a' -c 'redraw!' -c 'qa!'"
  make replay REPLAY="$VIM_RECORDING" >/dev/null 2>"$REPLAY_LOG"
  replay=$(<"$REPLAY_LOG")
  print "native-vim-mouse: $vim_version; ${replay//$'\n'/; }"
  [[ "$replay" == *"errors=0 ignored=0 unknown=csi:0,esc:0,osc:0,string:0"* ]] || {
    print -u2 "native Vim mouse recording contains parser errors, ignored actions, or unknown terminal controls."
    exit 1
  }
fi

if command -v vttest >/dev/null; then
  print "vttest: available; run make vttest in an interactive graphical session and record the selected cases."
else
  print "vttest: No access (not installed)"
fi

print "SSH: not attempted; use the documented command with a controlled remote host and record its result."
