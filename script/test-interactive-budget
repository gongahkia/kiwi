#!/usr/bin/env python3
"""Check regression detection and refusal of misleading timing comparisons."""
import copy
import json
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
trial = {"mode": "saturated", "trial": 1,
         "metadata": {"revision": {"commit": "a" * 40, "dirty": False},
                      "native_adapter": {"device": "test GPU", "backend_name": "Metal"},
                      "configuration": {"workload": "saturated", "presenter": "wgpu", "samples": 20},
                      "system": {"cpu_model": "test CPU", "cgroup_cpu_limit": "200000 100000"}, "runtime": {"jit": True}},
         "measurement": {"samples": 20, "callback_to_present_return_ms": {"values": [40] * 20, "p95": 0},
                         "launch_to_child_ready_present_return_ms": 1000, "sampled_peak_rss_kib": 128 * 1024}}
report = {"schema_version": 1, "status": "complete", "trials": []}
for number in range(1, 4):
    value = copy.deepcopy(trial)
    value["trial"] = number
    report["trials"].append(value)

with tempfile.TemporaryDirectory(prefix="kiwi-interactive-budget-") as temporary:
    baseline, candidate = Path(temporary) / "baseline.json", Path(temporary) / "candidate.json"
    baseline.write_text(json.dumps(report))
    def check(value, expected):
        candidate.write_text(json.dumps(value))
        result = subprocess.run([str(root / "script/check-interactive-budget"), str(baseline), str(candidate)],
                                capture_output=True, text=True, timeout=5)
        assert result.returncode == expected, (expected, result.returncode, result.stdout, result.stderr)
        return json.loads(result.stdout) if result.stdout else None
    assert check(report, 0)["status"] == "passed"
    for metric, value in (("launch_to_child_ready_present_return_ms", 1251), ("sampled_peak_rss_kib", 170000)):
        changed = copy.deepcopy(report)
        for item in changed["trials"]:
            item["measurement"][metric] = value
        assert check(changed, 1)["status"] == "regression"
    changed = copy.deepcopy(report)
    for item in changed["trials"]:
        item["measurement"]["callback_to_present_return_ms"]["values"] = [51] * 20
    evidence = check(changed, 1)
    assert evidence["checks"][0]["candidate"] == 51, "checker trusted a forged summary instead of samples"
    changed["trials"][0]["measurement"]["callback_to_present_return_ms"]["values"][0] = 2000
    check(changed, 2)
    for field in ("configuration", "system", "runtime", "native_adapter"):
        changed = copy.deepcopy(report)
        for item in changed["trials"]:
            item["metadata"][field]["different"] = True
        check(changed, 2)
    changed = copy.deepcopy(report)
    changed["trials"][1]["metadata"]["system"]["cgroup_cpu_limit"] = "100000 100000"
    check(changed, 2)
    changed = copy.deepcopy(report); changed["status"] = "failed"; check(changed, 2)
    changed = copy.deepcopy(report); changed["trials"].pop(); check(changed, 2)
    changed = copy.deepcopy(report); changed["trials"][1]["trial"] = 1; check(changed, 2)
    changed = copy.deepcopy(report); changed["trials"][0]["metadata"]["revision"]["dirty"] = True; check(changed, 2)
    changed = copy.deepcopy(report); del changed["trials"][0]["metadata"]["native_adapter"]; check(changed, 2)
    changed = copy.deepcopy(report); changed["trials"][0]["measurement"]["callback_to_present_return_ms"]["values"][0] = float("nan"); check(changed, 2)
print("Interactive regression budgets passed: real samples, independent trials, limits and incompatible-evidence rejection.")
