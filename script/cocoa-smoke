#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT=${0:A:h:h}
readonly APP="$ROOT/dist/Kiwi-dev.app"
readonly PID_FILE="$ROOT/.build/kiwi-dev.pid"

if [[ "$(uname -s)" != Darwin ]]; then
  print "SKIP Cocoa smoke: macOS is required."
  exit 0
fi

cd "$ROOT"
make native terminfo
"${LUAJIT:-luajit}" src/kiwi/cocoa_smoke.lua
./script/new-window-smoke
./script/session-move-smoke
./script/layout-restore-smoke

KIWI_MAX_FRAMES=0 ./script/build_and_run.sh --verify
app_pid=$(<"$PID_FILE")
[[ "$app_pid" == <-> ]]
kill "$app_pid"
for _ in {1..50}; do
  [[ ! -e "$PID_FILE" ]] && break
  sleep 0.1
done
[[ ! -e "$PID_FILE" ]]
plutil -lint "$APP/Contents/Info.plist" >/dev/null
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundlePackageType' "$APP/Contents/Info.plist")" == APPL ]]
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$APP/Contents/Info.plist")" == Kiwi ]]
[[ -x "$APP/Contents/MacOS/Kiwi" ]]
otool -l "$APP/Contents/MacOS/Kiwi" | rg -q 'LC_UUID'

print "Cocoa smoke passed: private clipboard, NSAccessibility projection, resized Metal surfaces, same-process session movement, layout restoration, UUID-bearing app launcher, and app-bundle launch."
