#!/usr/bin/env zsh
set -euo pipefail

# Common bash/zsh/fish integration order: cwd, prompt, command start/output,
# then command completion. This child is noninteractive and changes no shell
# startup configuration.
print -rn -- $'\e]7;file://kiwi.example/workspace\e\\'
print -rn -- $'\e]133;A\a'
print -rn -- 'kiwi$ '
print -rn -- $'\e]133;B\a'
print -r -- 'printf shell-metadata'
print -rn -- $'\e]133;C\a'
print -r -- 'shell-metadata'
print -rn -- $'\e]133;D;0\e\\'
