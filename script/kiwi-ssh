#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
usage: kiwi-ssh [--no-terminfo] [--strict] [--probe] [--ssh-option ARG]... -- host

Install Kiwi's compiled terminfo entry in ~/.cache/kiwi/terminfo on the named
remote host, then open an interactive login shell with TERM=xterm-kiwi. If setup
fails, the default behavior warns and falls back to TERM=xterm-256color.

--no-terminfo  skip remote setup and use the xterm-256color fallback
--strict       fail instead of falling back when remote setup fails
--probe        after setup, verify the remote private entry and print a fixed result
--ssh-option   pass one connection option or its value to both ssh and scp;
               repeat for every argument, for example:
               --ssh-option -p --ssh-option 2222
EOF
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=${KIWI_ROOT:-$(CDPATH= cd -- "$script_dir/.." && pwd)}
terminfo_root=${KIWI_TERMINFO:-}
if [ -z "$terminfo_root" ]; then
  if find "$project_root/.build/terminfo" -type f -name xterm-kiwi -print -quit 2>/dev/null | grep -q .; then
    terminfo_root="$project_root/.build/terminfo"
  else
    terminfo_root="$project_root/share/terminfo"
  fi
fi
terminfo_entry=$(find "$terminfo_root" -type f -name xterm-kiwi -print 2>/dev/null)
if [ "$(printf '%s\n' "$terminfo_entry" | sed '/^$/d' | wc -l | tr -d ' ')" -ne 1 ]; then
  terminfo_entry=''
else
  terminfo_entry=$(printf '%s\n' "$terminfo_entry" | sed -n '1p')
fi
terminfo_relative=${terminfo_entry#"$terminfo_root"/}
ssh_bin=${KIWI_SSH_BIN:-ssh}
scp_bin=${KIWI_SCP_BIN:-scp}
setup=true
strict=false
probe=false
ssh_options=''

append_ssh_option() {
  case "$1" in
    ''|*"
"*)
      printf '%s\n' "kiwi-ssh: SSH option arguments must be non-empty single lines" >&2
      exit 2
      ;;
  esac
  if [ -n "$ssh_options" ]; then ssh_options="$ssh_options
"; fi
  ssh_options="$ssh_options$1"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --no-terminfo) setup=false ;;
    --strict) strict=true ;;
    --probe) probe=true ;;
    --ssh-option)
      shift
      if [ "$#" -eq 0 ]; then
        printf '%s\n' "kiwi-ssh: --ssh-option requires one argument" >&2
        exit 2
      fi
      append_ssh_option "$1"
      ;;
    --ssh-option=*) append_ssh_option "${1#--ssh-option=}" ;;
    --) shift; break ;;
    *) printf '%s\n' "kiwi-ssh: use -- before the host; see --help" >&2; exit 2 ;;
  esac
  shift
done

if [ "$probe" = true ] && [ "$setup" = false ]; then
  printf '%s\n' "kiwi-ssh: --probe requires remote terminfo setup" >&2
  exit 2
fi

if [ "$#" -ne 1 ]; then
  printf '%s\n' "kiwi-ssh: exactly one host is required after --" >&2
  exit 2
fi
host=$1
case "$host" in
  ''|-*|*[[:space:]]*)
    printf '%s\n' "kiwi-ssh: host must be one non-option SSH destination" >&2
    exit 2
    ;;
esac

if ! command -v "$ssh_bin" >/dev/null 2>&1; then
  printf '%s\n' "kiwi-ssh: SSH client is unavailable: $ssh_bin" >&2
  exit 127
fi
if ! command -v "$scp_bin" >/dev/null 2>&1; then
  printf '%s\n' "kiwi-ssh: SCP client is unavailable: $scp_bin" >&2
  exit 127
fi

ssh_with_options() {
  command=$1
  set --
  if [ -n "$ssh_options" ]; then
    saved_ifs=$IFS
    IFS='
'
    set -f
    set -- $ssh_options
    set +f
    IFS=$saved_ifs
  fi
  "$ssh_bin" "$@" "$host" "$command"
}

scp_with_options() {
  set --
  if [ -n "$ssh_options" ]; then
    saved_ifs=$IFS
    IFS='
'
    set -f
    set -- $ssh_options
    set +f
    IFS=$saved_ifs
  fi
  "$scp_bin" "$@" "$terminfo_entry" "$host:.cache/kiwi/terminfo/$terminfo_relative"
}

fallback() {
  printf '%s\n' "kiwi-ssh: remote Kiwi terminfo setup failed; falling back to TERM=xterm-256color" >&2
  set --
  if [ -n "$ssh_options" ]; then
    saved_ifs=$IFS
    IFS='
'
    set -f
    set -- $ssh_options
    set +f
    IFS=$saved_ifs
  fi
  exec env TERM=xterm-256color COLORTERM=truecolor "$ssh_bin" "$@" -tt "$host"
}

if [ "$setup" = false ]; then
  set --
  if [ -n "$ssh_options" ]; then
    saved_ifs=$IFS
    IFS='
'
    set -f
    set -- $ssh_options
    set +f
    IFS=$saved_ifs
  fi
  exec env TERM=xterm-256color COLORTERM=truecolor "$ssh_bin" "$@" -tt "$host"
fi
if [ -z "$terminfo_entry" ] || [ ! -f "$terminfo_entry" ]; then
  printf '%s\n' "kiwi-ssh: missing compiled terminfo at $terminfo_entry; run make terminfo" >&2
  exit 2
fi

if ! ssh_with_options "mkdir -p \"\$HOME/.cache/kiwi/terminfo/${terminfo_relative%/*}\""; then
  if [ "$strict" = true ]; then exit 1; fi
  fallback
fi
if ! scp_with_options; then
  if [ "$strict" = true ]; then exit 1; fi
  fallback
fi
set --
if [ -n "$ssh_options" ]; then
  saved_ifs=$IFS
  IFS='
'
  set -f
  set -- $ssh_options
  set +f
  IFS=$saved_ifs
fi
if [ "$probe" = true ]; then
  exec env TERM=xterm-kiwi COLORTERM=truecolor "$ssh_bin" "$@" -tt "$host" 'TERM=xterm-kiwi TERMINFO="$HOME/.cache/kiwi/terminfo" COLORTERM=truecolor; export TERM TERMINFO COLORTERM; infocmp -x xterm-kiwi >/dev/null && [ "$(tput colors)" = 256 ] && tput setrgbf 1 2 3 >/dev/null && printf "%s\n" "kiwi-ssh probe: terminfo=xterm-kiwi colors=256 truecolor=true"'
fi
exec env TERM=xterm-kiwi COLORTERM=truecolor "$ssh_bin" "$@" -tt "$host" 'TERM=xterm-kiwi TERMINFO="$HOME/.cache/kiwi/terminfo" COLORTERM=truecolor exec "${SHELL:-/bin/sh}" -l'
