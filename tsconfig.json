{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "fried-apple-pie/sdk": ["./extensions/pie-ui/sdk.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ]
  },
  "include": [
    "extensions/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts"
  ]
}
