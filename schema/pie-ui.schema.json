{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gongahkia/fried-apple-pie/main/schema/pie-ui.schema.json",
  "title": "Fried Apple Pie UI config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "minimal",
        "claude-inspired",
        "opencode-inspired",
        "codex-inspired",
        "gemini-inspired",
        "aider-inspired",
        "copilot-inspired",
        "dracula",
        "tokyo-night",
        "catppuccin-mocha",
        "nord",
        "gruvbox-dark"
      ]
    },
    "theme": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["full", "theme-only", "footer-only", "widgets-only"]
    },
    "compact": {
      "type": "boolean"
    },
    "strict": {
      "type": "boolean"
    },
    "persona": {
      "type": "string"
    },
    "header": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "segments": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "enum": ["model", "thinking", "cwd", "branch", "status", "context", "tokens", "cost", "preset"]
              },
              {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": ["model", "thinking", "cwd", "branch", "status", "context", "tokens", "cost", "preset"]
                  },
                  "when": {
                    "type": "string",
                    "enum": ["always", "git-repo", "trusted-project", "context>50", "context>70", "context>90", "tokens>10k"]
                  }
                }
              }
            ]
          }
        },
        "separator": { "type": "string" }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "placement": { "type": "string", "enum": ["aboveEditor", "belowEditor"] },
        "lines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "expanded": { "type": "boolean" }
      }
    },
    "thinking": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "hiddenLabel": { "type": "string" }
      }
    },
    "working": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "visible": { "type": "boolean" },
        "message": { "type": "string" },
        "frames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "intervalMs": { "type": "number", "minimum": 25 }
      }
    }
  }
}
