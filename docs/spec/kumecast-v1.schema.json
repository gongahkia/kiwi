{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumeyuri.dev/spec/kumecast-v1.schema.json",
  "title": "Kumecast v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "theme", "timeline"],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagramType", "mermaid"],
      "properties": {
        "diagramType": {
          "type": "string",
          "minLength": 1
        },
        "mermaid": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "charset"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "charset": {
          "enum": ["ascii", "unicode"]
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat", "frames"],
      "properties": {
        "repeat": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "width", "height", "cells"],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glyph"],
      "properties": {
        "glyph": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "marker": {
          "type": "string"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "$ref": "#/$defs/color"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[a-f0-9]{6}$"
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "region"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
