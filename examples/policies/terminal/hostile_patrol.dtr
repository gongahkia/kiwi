type SelfObservation = { entity_id: Int, position: Position }
type Observation = { self: SelfObservation, tick: Int }
type Memory = { label: String }
type MoveToward = { target: Position }
type Decision = { intentions: List<MoveToward>, memory: Memory }

policy patrol(observation: Observation, memory: Memory) -> Decision =
  Decision {
    intentions = [MoveToward { target = Position { x = 2m, y = 0m } }],
    memory = memory
  }
