type SelfObservation = { entity_id: Int, position: Position }
type Contact = {
  age_ticks: Int,
  confidence_basis_points: Int,
  contact_id: Int,
  estimated_position: Position,
  uncertainty_radius: Distance
}
type Signal = { name: String, tick: Int }
type Observation = { nearest_contact: Option<Contact>, self: SelfObservation, signals: List<Signal> }
type Memory = { label: String }
type MoveToward = { target: Position }
type Decision = { intentions: List<MoveToward>, memory: Memory }

policy hold_until_precise(observation: Observation, memory: Memory) -> Decision =
  let advance = observation.signals |> List.find(fn signal -> true) in
  match advance with
  | Some(signal) ->
      Decision {
        intentions = [MoveToward { target = Position { x = 1m, y = 0m } }],
        memory = memory
      }
  | None -> Decision { intentions = [], memory = memory }
