# core
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# database
DATABASE_URL=postgres://wat:wat@localhost:5432/wat
POSTGRES_DB=wat
POSTGRES_USER=wat
POSTGRES_PASSWORD=wat

# auth, optional until auth providers are enabled
AUTH_SECRET=change-me
NEXTAUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
EMAIL_FROM=wat@localhost
EMAIL_SERVER=smtp://localhost:1025
MAILPIT_HTTP_URL=http://localhost:8025
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ERROR_TRACKING_WEBHOOK_URL=
ERROR_TEST_TOKEN=

# slack app, optional until Slack surface is enabled
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_REDIRECT_URI=http://localhost:3001/slack/oauth/callback
SLACK_STATE_SECRET=
SLACK_INSTALL_STORE=postgres
SLACK_INSTALL_STORE_PATH=.wat-slack-installs.json
SLACK_METRICS_TOKEN=
SLACK_TOKEN_ENCRYPTION_KEY=
SLACK_DATABASE_URL=postgres://wat:wat@localhost:5432/wat
WAT_SLACK_TEAM_MAP=
SLACK_WORKSPACE_RATE_LIMIT=30
SLACK_WORKSPACE_RATE_LIMIT_WINDOW_MS=60000
WAT_API_BASE_URL=http://localhost:3000

# teams app package, optional until Teams surface is enabled
TEAMS_PUBLIC_ORIGIN=http://localhost:3000
TEAMS_APP_ID=
TEAMS_API_SECRET_REGISTRATION_ID=
TEAMS_METRICS_TOKEN=

# discord app, optional until Discord surface is enabled
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INSTALL_SCOPES=applications.commands
DISCORD_INSTALL_GUILD_ID=
DISCORD_INSTALL_DISABLE_GUILD_SELECT=false
DISCORD_INSTALL_INTEGRATION_TYPE=0
DISCORD_BOT_PERMISSIONS=
DISCORD_INSTALL_STORE=postgres
DISCORD_INSTALL_STORE_PATH=.wat-discord-installs.json
DISCORD_METRICS_TOKEN=
DISCORD_DATABASE_URL=postgres://wat:wat@localhost:5432/wat
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
WAT_DISCORD_GUILD_MAP=

# external runtimes set these to an admin-created team API key
WAT_API_KEY=
WAT_TEAM_ID=team_example

# lookup rate limits
WAT_RATE_LIMIT_WINDOW_MS=60000
WAT_RATE_LIMIT_IP=60
WAT_RATE_LIMIT_USER=120
WAT_RATE_LIMIT_TEAM=300
WAT_VALIDATE_ENV=false
