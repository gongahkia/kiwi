{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gongahkia/kumeyuri",
  "title": "kumeyuri",
  "description": "Render, lint, and play Mermaid diagrams through kumeyuri.",
  "version": "1.1.0-plugins",
  "websiteUrl": "https://github.com/gongahkia/kumeyuri/blob/main/docs/mcp.md",
  "repository": {
    "url": "https://github.com/gongahkia/kumeyuri",
    "source": "github",
    "id": "1270271200",
    "subfolder": "crates/kumeyuri-cli"
  },
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "kumeyuri-cli",
      "version": "1.1.0-plugins",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--transport",
          "value": "stdio"
        }
      ]
    }
  ]
}
