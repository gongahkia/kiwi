compat-caveat-flowchart = trace animation; Mermaid config, styling, and exact visual parity are partial
compat-caveat-sequence = playback animation; colors, actor menus, links, and rich styling are partial
compat-caveat-state = transition animation; Mermaid layout/look config is rejected
compat-caveat-class = relationship trace animation; callbacks, links, and CSS styling are semantic-only
compat-caveat-er = relationship trace animation; Mermaid styling/config is not interpreted
compat-caveat-gantt = timeline trace animation; date handling is day-level
compat-caveat-pie = slice trace animation; theme variables and hover behavior are not rendered
compat-caveat-mindmap = tree trace animation; CSS classes and icon registration are semantic-only
compat-caveat-journey = trace animation; Mermaid color palettes are approximated
compat-caveat-gitgraph = commit trace animation; display config fields are semantic-only
compat-caveat-timeline = reveal animation; theme variables and direction styling are not rendered
compat-caveat-quadrant = static frame; classes are semantic-only
compat-caveat-requirement = static frame; styles/classes are semantic-only
compat-caveat-c4 = static frame; C4 geometry is schematic and CSS colors are style rows
compat-caveat-zenuml = static frame; activation stack styling is not modeled
compat-caveat-sankey = static frame; link widths/colors are schematic
compat-caveat-xy = static frame; horizontal orientation is parsed but rendered schematically
compat-caveat-block = static frame; styles/classes and arrow geometry are approximate
compat-caveat-packet = static frame; packet sizing config is not interpreted
compat-caveat-kanban = static frame; metadata is rendered as text
compat-caveat-architecture = static frame; icons/classes are text-only
compat-caveat-radar = static frame; circular styling and curve fills are approximate
compat-caveat-event-modeling = static frame; Mermaid padding/rowHeight config is not interpreted
compat-caveat-treemap = static frame; classDef and D3 value formatting are semantic-only
compat-caveat-venn = static frame; proportional area and theme colors are approximate
compat-caveat-ishikawa = static frame; fishbone geometry is approximate
compat-caveat-wardley = static frame; exact Mermaid geometry and styling are approximate
compat-caveat-treeview = static frame; icons/classes are text-only
compat-caveat-cynefin = no parser root; rejected at parser-header detection
compat-caveat-railroad = no parser root; rejected at parser-header detection
compat-caveat-swimlanes = no parser root; rejected at parser-header detection
