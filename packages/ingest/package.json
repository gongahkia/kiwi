{
  "name": "@wat/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "contemporaries:coverage": "tsx src/contemporaries-coverage.ts",
    "contemporaries:lint": "tsx src/contemporaries-lint.ts",
    "ingest": "tsx src/cli.ts",
    "lint:sources": "tsx src/source-coverage.ts seeds/manual.json ../../data/deltas",
    "registry:check": "tsx src/source-registry.ts",
    "refresh:report": "tsx src/refresh-report.ts",
    "summarize:delta": "tsx src/delta-summary.ts",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/spdx-license-ids": "^3.0.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "spdx-license-ids": "^3.0.23",
    "yaml": "^2.9.0"
  }
}
