{
  "name": "@strok/embed",
  "version": "0.0.0",
  "description": "Embeddable strok ANSI/asciinema player as a Web Component with a React wrapper.",
  "type": "module",
  "sideEffects": [
    "./dist/strok-embed.js"
  ],
  "main": "./dist/strok-embed.js",
  "module": "./dist/strok-embed.js",
  "types": "./dist/strok-embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist/strok-embed.d.ts",
      "import": "./dist/strok-embed.js",
      "default": "./dist/strok-embed.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.js",
      "default": "./react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "react",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
