type SelfObservation = { entity_id: Int, position: Position }
type Observation = { self: SelfObservation, tick: Int }
type Memory = { label: String }
type TakeCover = { cover_id: Int, side: String }
type Decision = { intentions: List<TakeCover>, memory: Memory }

policy reserve(observation: Observation, memory: Memory) -> Decision =
  Decision {
    intentions = [TakeCover { cover_id = 1, side = "left" }],
    memory = memory
  }
