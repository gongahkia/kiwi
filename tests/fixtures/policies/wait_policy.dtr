type SelfObservation = { entity_id: Int, position: Position }
type Observation = { self: SelfObservation, tick: Int }
type Memory = { label: String }
type Wait = { duration: Duration }
type Decision = { intentions: List<Wait>, memory: Memory }

policy wait_once(observation: Observation, memory: Memory) -> Decision =
  Decision { intentions = [Wait { duration = 1s }], memory = memory }
