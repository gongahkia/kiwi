type Memory = { last: Position, label: String }
type Decision = { intentions: List<Int>, memory: Memory }

policy decide(memory: Memory, target: Option<Position>) -> Decision =
  let offset = Vector { dx = 1m, dy = 0m } in
  let next = match target with
    | Some(point) -> point + offset
    | None -> memory.last
  in
  let intentions = [1, 2] |> List.map(fn item -> item) in
  if 250ms < 1s then
    Decision {
      intentions = intentions,
      memory = Memory { label = "ready", last = next }
    }
  else
    Decision {
      intentions = [],
      memory = memory
    }
