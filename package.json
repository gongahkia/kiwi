{
  "name": "wat",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "changeset": "changeset",
    "db:generate": "pnpm --filter @wat/db db:generate",
    "db:migrate": "pnpm --filter @wat/db db:migrate",
    "db:seed:dev": "pnpm --filter @wat/db seed:dev",
    "dev": "sh -c 'pnpm --filter @wat/web dev'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest": "pnpm --filter @wat/ingest ingest",
    "lint": "eslint . && prettier --check .",
    "prepare": "husky",
    "test:e2e:auth": "sh scripts/e2e-auth-mailpit.sh",
    "test:e2e:web": "playwright test e2e/web-search.spec.ts",
    "typecheck": "tsc -b --noEmit",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
