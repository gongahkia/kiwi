{
  "name": "wat",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "audit:deps": "pnpm audit --audit-level high",
    "audit:licenses": "pnpm licenses list --prod",
    "bench": "pnpm --filter @wat/search bench",
    "bootstrap:admin": "tsx packages/db/src/bootstrap-admin.ts",
    "build": "tsc -b",
    "build:all": "pnpm -r --filter '@wat/*' --if-present build",
    "changeset": "changeset",
    "db:deploy": "pnpm db:migrate && pnpm db:seed:public",
    "db:generate": "pnpm --filter @wat/db db:generate",
    "db:migrate": "pnpm --filter @wat/db db:migrate",
    "db:seed:dev": "pnpm --filter @wat/db seed:dev",
    "db:seed:public": "pnpm --filter @wat/db seed:public",
    "demo:local": "sh scripts/local-demo.sh",
    "dev": "sh -c 'pnpm --filter @wat/web dev'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest": "pnpm --filter @wat/ingest ingest",
    "latency:search": "tsx scripts/measure-search-latency.ts",
    "lint": "eslint . && prettier --check .",
    "load:search": "k6 run scripts/k6-search.js",
    "prepare": "husky",
    "rollback:delta": "node scripts/rollback-delta.mjs",
    "smoke:local-demo": "sh scripts/smoke-local-demo.sh",
    "smoke:discord": "node scripts/smoke-platforms.mjs discord",
    "smoke:platforms": "node scripts/smoke-platforms.mjs all",
    "smoke:slack": "node scripts/smoke-platforms.mjs slack",
    "smoke:teams": "node scripts/smoke-platforms.mjs teams",
    "test": "pnpm -r --if-present test",
    "test:e2e:auth": "sh scripts/e2e-auth-mailpit.sh",
    "test:e2e:extension": "pnpm --filter @wat/ext build && playwright test -c playwright.extension.config.ts",
    "test:e2e:web": "playwright test e2e/web-search.spec.ts",
    "typecheck": "tsc -b --noEmit",
    "version-packages": "changeset version"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.8.4",
      "tmp": "^0.2.7",
      "undici": "^6.27.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
