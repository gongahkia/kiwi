{
  "name": "fried-apple-pie",
  "version": "0.1.0",
  "description": "Pi UI presets, themes, and agent-editable config.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./extensions/pie-ui/sdk.ts",
      "import": "./extensions/pie-ui/sdk.ts",
      "default": "./extensions/pie-ui/sdk.ts"
    },
    "./sdk": {
      "types": "./extensions/pie-ui/sdk.ts",
      "import": "./extensions/pie-ui/sdk.ts",
      "default": "./extensions/pie-ui/sdk.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fap": "./bin/fap.mjs"
  },
  "author": "gongahkia",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "coding-agent",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongahkia/fried-apple-pie.git"
  },
  "homepage": "https://github.com/gongahkia/fried-apple-pie#readme",
  "bugs": {
    "url": "https://github.com/gongahkia/fried-apple-pie/issues"
  },
  "files": [
    "assets",
    "bin",
    "examples",
    "extensions",
    "LICENSE",
    "schema",
    "themes",
    "skills",
    "README.md"
  ],
  "scripts": {
    "assets:build": "sips -s format png assets/fried-apple-pie-gallery.svg --out assets/fried-apple-pie-gallery.png >/dev/null && magick -delay 140 assets/fried-apple-pie-gallery.png -delay 140 assets/fried-apple-pie-gallery.png -loop 0 assets/fried-apple-pie-demo.gif",
    "assets:tapes": "./scripts/gen-tapes.sh",
    "assets:capture": "./scripts/capture.sh",
    "smoke:pi": "pi -e . --offline --no-context-files --list-models >/dev/null",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/pie-ui"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "image": "https://raw.githubusercontent.com/gongahkia/fried-apple-pie/main/assets/fried-apple-pie-gallery.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.79.10",
    "@earendil-works/pi-tui": "0.79.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.22.4",
    "typebox": "^1.3.0",
    "typescript": "^6.0.3"
  }
}
